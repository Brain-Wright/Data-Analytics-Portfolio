from statsmodels.tsa.arima.model import ARIMA
import numpy as np

# Ensure date is in datetime format
df['Date'] = pd.to_datetime(df['Date'])

# Group by month to get monthly revenue
monthly_revenue = df.resample('M', on='Date')['Real_Total_Revenue'].sum()

# Train ARIMA model
train_data = monthly_revenue
model = ARIMA(train_data, order=(5, 1, 0))  # ARIMA(p,d,q), p=5, d=1, q=0 for simplicity
model_fit = model.fit()

# Forecast next 3 months
forecast = model_fit.forecast(steps=3)
forecast_dates = pd.date_range(start=monthly_revenue.index[-1], periods=4, freq='M')[1:]

# Plot forecasted data
plt.figure(figsize=(10, 6))
plt.plot(monthly_revenue, label='Historical Revenue')
plt.plot(forecast_dates, forecast, label='Forecasted Revenue', color='orange', linestyle='--')
plt.title('Revenue Forecast for Next 3 Months')
plt.xlabel('Date')
plt.ylabel('Revenue ($)')
plt.legend()
plt.tight_layout()
plt.show()

